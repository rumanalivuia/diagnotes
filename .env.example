# DiagNotes env — copy to .env.local for local dev (neon env pull does this for you)
# Server (Neon Postgres)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.c-4.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.c-4.aws.neon.tech/neondb?sslmode=require"
NEON_BRANCH=production
NEON_AUTH_BASE_URL="https://ep-xxx.neonauth.c-4.aws.neon.tech/neondb/auth"
NEON_AUTH_JWKS_URL="https://ep-xxx.neonauth.c-4.aws.neon.tech/neondb/auth/.well-known/jwks.json"

# Auth / center login (single shared account per deployment)
DIAGNOTES_EMAIL="diagnotes@center.local"
DIAGNOTES_PASSWORD="admin123"
DIAGNOTES_SECRET="replace-with-random-32-byte-hex"

# CORS (comma-separated) — set to your Vercel URL(s) in production
CORS_ORIGIN="*"

# Web (Vite) — point at hosted API when web and API are separate origins
# Leave empty for same-origin (Vercel rewrites /api -> api/index.js)
VITE_API_BASE_URL=""
PORT=3001
